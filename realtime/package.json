{
  "name": "ispan-realtime",
  "version": "0.1.0",
  "private": true,
  "description": "Socket.io gateway for iSpan job tracking and chat.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
