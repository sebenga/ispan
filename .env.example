DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# Leave empty for SQLite. Docker Compose Postgres:
DATABASE_URL=postgres://ispan:ispan@127.0.0.1:5433/ispan
REDIS_URL=redis://127.0.0.1:6380/0

JWT_SIGNING_KEY=change-me-to-a-long-random-string-32b+
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14
INTERNAL_API_TOKEN=dev-internal-token

CORS_ALLOWED_ORIGINS=http://localhost:8100,http://127.0.0.1:8100
PUBLIC_APP_ORIGIN=http://localhost:8100
PUBLIC_API_ORIGIN=http://localhost:8001
REALTIME_URL=http://localhost:4000
REALTIME_EVENT_CHANNEL=ispan:events
REALTIME_CORS_ORIGINS=http://localhost:8100,http://127.0.0.1:8100
REALTIME_POLLING=false

DEFAULT_CURRENCY=ZAR
DEFAULT_TIMEZONE=Africa/Johannesburg
LEGAL_VERSION=2026-11-19

PAYMENT_PROVIDER=mock
PAYMENTS_WEBHOOK_SECRET=
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
YOCO_SECRET_KEY=
PAYSTACK_SECRET_KEY=
OZOW_SITE_CODE=

KYC_PROVIDER=mock
SMS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
MEDIA_ENCRYPTION_KEY=

FEATURE_PARTNER_OFFERS=false
ESCROW_AUTO_RELEASE_HOURS=24
OFFER_SECONDS=20
MATCH_INITIAL_RADIUS_KM=5
CANCELLATION_LATE_FEE_BPS=5000
CANCELLATION_WINDOW_MINUTES=120
CASH_DEBT_BLOCK_CENTS=15000
MIN_PAYOUT_CENTS=10000
COMMISSION_BPS=1250

SENTRY_DSN=
